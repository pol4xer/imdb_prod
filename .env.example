# Optional runtime overrides. The app reads environment variables, not this file.
IMDB_ROOT=./var
IMDB_PORT=8000

# Optional: leave empty to generate a session key for the current process.
IMDB_SECRET_KEY=

# Live IMDb requests are disabled by default; the demo needs no account.
IMDB_ENABLE_LIVE=false
IMDB_COOKIES_FILE=
