<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Film development report</title>
    <style>
        @page {
            size: A4 landscape;
            margin: 16mm;
            @frame footer {
                -pdf-frame-content: footerContent;
                bottom: 5mm;
                margin-left: 16mm;
                margin-right: 16mm;
                height: 8mm;
            }
        }
        body { font-family: Helvetica, sans-serif; font-size: 8pt; color: #243040; }
        h1 { font-size: 21pt; color: #14283e; margin: 0 0 5mm; }
        .eyebrow { font-size: 8pt; color: #596a7d; margin: 0 0 10pt; }
        table { width: 100%; }
        th, td { padding: 6pt; text-align: left; vertical-align: top; }
        th { background-color: #e8eef4; border-bottom: 1pt solid #b8c7d6; font-size: 7pt; }
        td { border-bottom: 0.5pt solid #dbe3ea; }
        .title { width: 14%; }
        .logline { width: 24%; }
        .cast { width: 12%; }
        .director { width: 11%; }
        .producers { width: 13%; }
        .executive { width: 13%; }
        .companies { width: 13%; }
        .status { font-size: 7pt; color: #52677c; }
        .footer { text-align: right; font-size: 7pt; color: #687b8c; }
    </style>
</head>
<body>
    {% for company_name, films in data_to_render.items() %}
    {% if not loop.first %}<pdf:nextpage />{% endif %}
    <p class="eyebrow">FILM DEVELOPMENT REPORT · {{ date }}</p>
    <h1>{{ company_name }}</h1>
    <table repeat="1">
        <thead>
            <tr>
                <th class="title">Film title / status</th>
                <th class="logline">Logline</th>
                <th class="cast">Cast</th>
                <th class="director">Director</th>
                <th class="producers">Producers</th>
                <th class="executive">Executive producers</th>
                <th class="companies">Production companies</th>
            </tr>
        </thead>
        <tbody>
            {% for film in films %}
            <tr>
                <td class="title"><strong>{{ film.title }}</strong><br><span class="status">{{ film.status }}</span></td>
                <td class="logline">{{ film.logline }}</td>
                <td class="cast">{% for person in film.cast %}{{ person }}<br>{% endfor %}</td>
                <td class="director">{{ film.director }}</td>
                <td class="producers">{% for person in film.producers %}{{ person }}<br>{% endfor %}</td>
                <td class="executive">{% for person in film.executive_producers %}{{ person }}<br>{% endfor %}</td>
                <td class="companies">{% for company in film.production_companies %}{{ company }}<br>{% endfor %}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endfor %}
    <div id="footerContent" class="footer">Page <pdf:pagenumber/> of <pdf:pagecount/></div>
</body>
</html>
